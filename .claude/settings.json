{
  "permissions": {
    "allow": [
      "Bash(npm test:*)",
      "Bash(npm run build:*)",
      "Bash(node kiem_tra_truoc_khi_giao.js:*)",
      "Bash(node --check:*)",
      "Bash(python3 dong_tien_do.py:*)",
      "Bash(grep:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git checkout -b:*)",
      "Bash(git branch:*)",
      "Bash(bash ban_mau_pos/chay_thu.sh:*)"
    ],
    "deny": [
      "Bash(git push:*)",
      "Bash(git merge:*)",
      "Bash(git add -A:*)",
      "Bash(git add .:*)",
      "Bash(git commit --no-verify:*)",
      "Bash(git reset --hard:*)",
      "Bash(git checkout main:*)",
      "Bash(git checkout master:*)",
      "Bash(rm -rf:*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./.replit)",
      "Edit(./.claude/**)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Edit(./.replit)",
      "Edit(./TIEN_DO_*.json)",
      "Bash(git push *)",
      "Bash(git merge *)",
      "Bash(git reset *)",
      "Bash(git commit -n *)",
      "Bash(git -c *)",
      "Bash(git *--no-v*)"
    ],
    "defaultMode": "default"
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/nhac_sau_sua.cjs\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/kiem_truoc_khi_dung.cjs\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/tu_chay/nguoi_gac.js\" || exit 2",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "model": "claude-opus-5-5",
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "claude-opus-5-5"
  }
}
