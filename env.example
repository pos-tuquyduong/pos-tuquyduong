# ═══════════════════════════════════════════════════════════════
# POS TURSO - Environment Variables
# Copy file này thành .env và điền thông tin
# ═══════════════════════════════════════════════════════════════

# === TURSO DATABASE (BẮT BUỘC) ===
# Lấy từ Turso Dashboard: https://turso.tech/app
TURSO_DATABASE_URL=libsql://your-database-name-your-username.turso.io
TURSO_AUTH_TOKEN=your-auth-token-here

# === JWT SECRET (BẮT BUỘC) ===
# Tạo random string để bảo mật token
JWT_SECRET=your-super-secret-key-change-this-in-production
JWT_EXPIRES_IN=8h

# === SX SYSTEM CONNECTION (TÙY CHỌN) ===
# Kết nối với hệ thống Sản xuất
SX_API_URL=https://your-sx-system.railway.app
SX_API_KEY=your-sx-api-key

# === SERVICE-TO-SERVICE API KEY (dùng cho App KH / worker đồng bộ, KHÔNG bắt buộc lúc này) ===
# Cho phép máy-gọi-máy (App KH backend, worker đồng bộ...) gọi vào 1 số API cụ thể mà
# không cần JWT nhân viên — gửi kèm header `X-Service-Key: <giá trị này>`.
# Chưa điền = các endpoint này chỉ chạy được qua JWT nhân viên như bình thường, không lỗi gì.
# Khi bắt đầu code App KH backend: tạo 1 chuỗi ngẫu nhiên dài (vd `openssl rand -hex 32`),
# điền vào đây VÀ vào cấu hình App KH backend — 2 bên phải khớp nhau.
POS_SERVICE_API_KEY=

# === APP KH — cổng khách /api/kh (KH-API-1) ===
# Khoá ký token KHÁCH: chuỗi ngẫu nhiên dài (vd `openssl rand -hex 32`), PHẢI KHÁC JWT_SECRET.
# Để trống hoặc trùng JWT_SECRET = App KH đóng: mọi /api/kh/* trả 503 KH_CHUA_CAU_HINH.
KH_JWT_SECRET=
# Cách gửi mã đăng nhập: quay (mặc định — không gửi, khách lấy mã tại quầy). Chế độ gửi tin thật thêm ở KH-OTP-1.
GUI_MA_KHACH=quay

# === payOS — QR chuyển khoản tự xác nhận (P3) ===
# Lấy ở trang kênh thanh toán payOS. CHỈ điền ở Secrets / biến môi trường Render — không bao giờ ghi vào kho, log, chat.
# Thiếu một trong ba = tạo phiên payOS trả 503 PAYOS_CHUA_CAU_HINH (quầy dùng QR tĩnh của quán + xác nhận tay).
# URL webhook khai ở payOS: https://<tên miền>/api/payos/webhook
# Kho thử (Replit) dùng kênh payOS RIÊNG hoặc để trống: mã đơn payOS = mã phiên, hai kho dùng chung một kênh sẽ trùng mã.
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
# Trang payOS quay về sau khi khách trả / huỷ trên trang thanh toán (không bắt buộc).
PAYOS_RETURN_URL=

# === Công tắc cổng QR + SePay (SEPAY-1) ===
# CONG_QR chọn cổng QR tự xác nhận: sepay | payos. Để trống = payos. Giá trị khác = coi như chưa cài (503 PAYOS_CHUA_CAU_HINH).
# Webhook của CẢ HAI cổng luôn mở: phiên tạo trước khi đổi công tắc vẫn tự chốt nếu tiền về trong hạn 10 phút, quá hạn thì ghi vào Đối soát
# (như payOS) — giữ khoá cổng cũ ít nhất một ngày; xoá khoá thì báo của cổng đó bị từ chối, không có dấu vết.
CONG_QR=
# SePay: POS tự dựng VietQR tới tài khoản quán; SePay báo tiền về qua webhook https://<tên miền>/api/sepay/webhook (xác thực HMAC-SHA256).
# SEPAY_BIN = mã BIN ngân hàng của tài khoản nhận (6 chữ số). SEPAY_SO_TK = số tài khoản nhận. SEPAY_KHOA_WEBHOOK = Secret Key của webhook
# (SePay chỉ hiện đủ MỘT lần lúc tạo). Thiếu / sai dạng một trong ba khi CONG_QR=sepay = 503 PAYOS_CHUA_CAU_HINH. CHỈ điền ở Render.
SEPAY_BIN=
SEPAY_SO_TK=
SEPAY_KHOA_WEBHOOK=

# === SERVER CONFIG ===
PORT=3000
NODE_ENV=production
